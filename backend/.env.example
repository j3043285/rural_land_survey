# Environment Configuration for Production

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database - Railway will provide this automatically
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/rural_land_db

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=https://your-frontend.railway.app,https://your-domain.com

# Land Data Provider (mock or official)
LAND_DATA_PROVIDER=mock

# Upload Directory (use absolute path in production)
UPLOAD_DIR=/app/uploads

# Optional: Official Maharashtra API
# OFFICIAL_LAND_API_URL=https://api.mahabhulekh.gov.in
# OFFICIAL_LAND_API_KEY=your-api-key
