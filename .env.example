# Smart India Hackathon - LandSetu Project
# Environment Variables Configuration

# Backend Configuration
SECRET_KEY=sih2026-rural-land-survey-secure-token-key-2026-change-in-production
DATABASE_URL=sqlite:///./rural_land.db
# For production with PostgreSQL/MySQL, use:
# DATABASE_URL=postgresql://user:password@localhost:5432/landsetu_db
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/landsetu_db

# API Configuration
LAND_DATA_PROVIDER=mock
# OFFICIAL_LAND_API_URL=https://mahabhulekh.maharashtra.gov.in/api
# OFFICIAL_LAND_API_KEY=your-api-key-here

# Upload Directory
UPLOAD_DIR=./uploads

# Discrepancy Threshold (percentage)
DISCREPANCY_THRESHOLD_PCT=2.0

# Frontend Configuration (for build time)
VITE_API_URL=http://localhost:8000/api

# Optional: ML Model Path
ML_MODEL_PATH=./backend/app/models/dispute_prediction_model.pkl

# Optional: Blockchain Configuration (for future integration)
# BLOCKCHAIN_NETWORK=testnet
# BLOCKCHAIN_CONTRACT_ADDRESS=0x...
